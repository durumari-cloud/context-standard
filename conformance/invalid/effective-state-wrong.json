        "revision": 1,
        "title": "HTTP client — timeouts and retries for partner APIs",
        "summary": "Every partner API request has a timeout and is retried; this spec fixes both.",
        "tags": [
          "APP-11",
          "area-api"
        ],
        "kind": "spec",
        "state": "active",
        "trust": "reported",
        "body": "# Purpose and scope\nThe HTTP client used by the export service talks to partner APIs.\n\n# Requirements\n- Every request has a timeout.\n- Failed requests are retried three times with a fixed 1 s delay.\n\n# Acceptance criteria\n- A request that never answers fails after the timeout.\n\n# Out of scope\nStreaming downloads.\n",
