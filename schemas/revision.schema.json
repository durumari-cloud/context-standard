{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:durumari-context-standard:0.1:schema:revision",
  "title": "Revision",
  "description": "An immutable snapshot of a document (spec chapter 1.3).",
  "type": "object",
  "required": [
    "context_id", "revision", "title", "summary", "tags", "kind", "state", "trust",
    "body", "sections", "provenance", "supersedes", "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "context_id": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/id" },
    "revision": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/revisionNumber" },
    "title": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/title" },
    "summary": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/summary" },
    "tags": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/tags" },
    "kind": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/kind" },
    "state": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/state" },
    "trust": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/trust" },
    "body": { "type": "string" },
    "sections": {
      "type": "array",
      "items": { "$ref": "urn:durumari-context-standard:0.1:schema:section" },
      "minItems": 1
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "urn:durumari-context-standard:0.1:schema:provenance" },
      "maxItems": 16
    },
    "supersedes": {
      "type": "array",
      "items": { "$ref": "urn:durumari-context-standard:0.1:schema:supersession" },
      "maxItems": 16
    },
    "created_at": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/timestamp" },
    "author": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/actor" }
  }
}
