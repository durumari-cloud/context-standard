{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:durumari-context-standard:0.1:schema:section",
  "title": "Section",
  "description": "One section of a document body (spec chapter 2).",
  "type": "object",
  "required": ["id", "title", "text", "sha256"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/sectionId" },
    "title": { "type": "string", "maxLength": 200 },
    "text": { "type": "string" },
    "sha256": { "$ref": "urn:durumari-context-standard:0.1:schema:common#/$defs/sha256" },
    "level": { "type": "integer", "minimum": 0, "maximum": 6 }
  }
}
